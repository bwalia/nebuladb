#!/bin/sh
# Showcase auth for nginx (sourced before envsubst).
#
# HTTP basic auth — ON unless explicitly disabled:
#   SHOWCASE_AUTH_DISABLED=true   no basic auth
#   SHOWCASE_AUTH_USERNAME / SHOWCASE_AUTH_PASSWORD
#
# Google OAuth (oauth2-proxy sidecar + nginx auth_request):
#   SHOWCASE_GOOGLE_AUTH=true     write oauth gate into
#                                 /etc/nginx/showcase-oauth-gate.conf
#   Unauthenticated users land on /login (Google + optional password).
#   When Google is on, nginx basic auth is forced off; password sign-in
#   goes through oauth2-proxy --htpasswd-file (shared volume).
#
# Password-only session (oauth2-proxy sidecar, no Google):
#   SHOWCASE_SESSION_LOGIN=true   same gate as Google, but /login shows
#                                 only the password form. The sidecar's
#                                 cookie is what keeps users signed in.
#
# Plain basic auth (neither of the above) has no session cookie, so the
# branded form can't sign anyone in: 401 is left to the browser's own
# username/password prompt.
#
# Also writes /usr/share/nginx/html/login-config.json so the public
# login page knows which methods to show.

# nginx injects `Authorization: Bearer ${NEBULA_API_KEYS}` upstream. The
# server takes a comma-separated list (the showcase's own key first, then
# one per external API client), but a bearer is a single key: keep the first.
export NEBULA_API_KEYS="${NEBULA_API_KEYS%%,*}"

showcase_htpasswd=/etc/nginx/showcase.htpasswd
oauth_gate=/etc/nginx/showcase-oauth-gate.conf
login_config=/usr/share/nginx/html/login-config.json
: >"$showcase_htpasswd"
: >"$oauth_gate"
# /shared/oauth2/htpasswd is owned by the prepare-htpasswd initContainer
# (bcrypt for oauth2-proxy). Do not overwrite it with apr1 here.

google_on=false
case "$(printf '%s' "${SHOWCASE_GOOGLE_AUTH:-false}" | tr '[:upper:]' '[:lower:]')" in
  true|1|yes|on) google_on=true ;;
esac
session_on=false
case "$(printf '%s' "${SHOWCASE_SESSION_LOGIN:-false}" | tr '[:upper:]' '[:lower:]')" in
  true|1|yes|on) session_on=true ;;
esac

write_htpasswd() {
  case "${SHOWCASE_AUTH_USERNAME:-}" in
    *:*) echo "showcase-auth: SHOWCASE_AUTH_USERNAME must not contain ':'" >&2; exit 1 ;;
  esac
  if [ -n "${SHOWCASE_AUTH_USERNAME:-}" ] && [ -n "${SHOWCASE_AUTH_PASSWORD:-}" ]; then
    # nginx basic auth wants apr1; oauth2-proxy wants bcrypt (initContainer).
    printf '%s:%s\n' "$SHOWCASE_AUTH_USERNAME" \
      "$(printf '%s' "$SHOWCASE_AUTH_PASSWORD" | openssl passwd -apr1 -stdin)" \
      >"$showcase_htpasswd"
    return 0
  fi
  return 1
}

password_on=false
if write_htpasswd; then
  password_on=true
  echo "showcase-auth: htpasswd ready for user '$SHOWCASE_AUTH_USERNAME'" >&2
fi
if [ "$google_on" = true ] || [ "$session_on" = true ]; then
  # 401 → branded /login (not straight to Google). /login is auth-exempt.
  cat >"$oauth_gate" <<'EOF'
    auth_request /oauth2/auth;
    error_page 401 = @showcase_oauth_start;
    auth_request_set $auth_email $upstream_http_x_auth_request_email;
    auth_request_set $auth_user $upstream_http_x_auth_request_user;
EOF
  export SHOWCASE_AUTH_BASIC=off
  mode=session
  [ "$google_on" = true ] && mode=google
  printf '{"google":%s,"password":%s,"mode":"%s"}\n' "$google_on" \
    "$([ "$password_on" = true ] && echo true || echo false)" "$mode" >"$login_config"
  echo "showcase-auth: oauth2-proxy gate on ($mode) → /login (password=$password_on)" >&2
else
  # No oauth2-proxy: define the identity variables the agent location
  # forwards (basic auth fills $remote_user instead), or nginx won't load.
  printf '%s\n' '# google oauth gate off' 'set $auth_email "";' 'set $auth_user "";' >"$oauth_gate"
  case "$(printf '%s' "${SHOWCASE_AUTH_DISABLED:-false}" | tr '[:upper:]' '[:lower:]')" in
    true|1|yes|on)
      export SHOWCASE_AUTH_BASIC=off
      printf '{"google":false,"password":false,"mode":"open"}\n' >"$login_config"
      echo "showcase-auth: basic auth disabled" >&2
      ;;
    *)
      export SHOWCASE_AUTH_BASIC='"NebulaDB Showcase"'
      if [ "$password_on" != true ]; then
        echo "showcase-auth: basic auth is on but credentials unset; every login will be refused" >&2
      fi
      # No 401 → /login rewrite: the browser's prompt is the sign-in.
      echo "# basic auth: browser prompt" >>"$oauth_gate"
      printf '{"google":false,"password":%s,"mode":"basic"}\n' \
        "$([ "$password_on" = true ] && echo true || echo false)" >"$login_config"
      echo "showcase-auth: basic auth on → browser prompt (password=$password_on)" >&2
      ;;
  esac
fi

unset showcase_htpasswd oauth_gate login_config google_on session_on mode password_on
unset -f write_htpasswd